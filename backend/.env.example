# Copy to backend/.env. Values come from `supabase status` after `supabase start`.
# The setup script (scripts/setup_local.sh / .ps1) fills these in automatically.

# From `supabase status` -> "API URL"
SUPABASE_URL=http://127.0.0.1:54321

# From `supabase status` -> "service_role key"  (server-side only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=PASTE_LOCAL_SERVICE_ROLE_KEY_HERE

# From `supabase status` -> "JWT secret"
SUPABASE_JWT_SECRET=PASTE_LOCAL_JWT_SECRET_HERE

CORS_ORIGINS=http://localhost:3000

# Optional: email notifications. Leave blank to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=LostLink <noreply@lostlink.app>

# Preload CLIP + MiniLM at startup (slower boot, instant first match).
# Leave false to download/load models lazily on the first upload.
WARMUP_MODELS=false

DEBUG=true
